{
  "elements": [
    {
      "type": "NumberSpinner",
      "name": "update_interval",
      "caption": "Aktualisierungsintervall (Sekunden)",
      "minimum": 15,
      "suffix": "s"
    },
    {
      "type": "Label",
      "caption": "Eine Instanz pro Raum. Alle Felder sind optional -- ungenutzte Widgets/Listen werden im Dashboard einfach nicht angezeigt."
    },
    {
      "type": "ExpansionPanel",
      "caption": "Präsenz (optional)",
      "expanded": false,
      "items": [
        { "type": "SelectVariable", "name": "var_presence", "caption": "Präsenzmelder (Boolean)" }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Sonos (optional)",
      "expanded": false,
      "items": [
        {
          "type": "SelectInstance",
          "name": "sonos_instance",
          "caption": "Sonos-Player-Instanz",
          "validModules": ["{52F6586D-A1C7-AAC6-309B-E12A70F6EEF6}"]
        },
        { "type": "Label", "caption": "Play/Pause/Weiter/Zurück, aktueller Titel, Lautstärke, Stumm, Playlist- und Gruppenauswahl werden automatisch aus der Sonos-Instanz gelesen -- keine weitere Konfiguration nötig." }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Luftfeuchtigkeit (optional)",
      "expanded": false,
      "items": [
        {
          "type": "SelectInstance",
          "name": "humidity_instance",
          "caption": "Luftfeuchtigkeitsrechner-Instanz",
          "validModules": ["{B4F9A13F-13F3-FA6D-6745-4DB513A13B25}"]
        },
        { "type": "Label", "caption": "Lüftungsempfehlung, Ergebnistext und Taupunkte werden automatisch aus der Rechner-Instanz gelesen." }
      ]
    },
    {
      "type": "List",
      "name": "thermostats",
      "caption": "Temperatur",
      "rowCount": 3,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "180px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Thermostat", "name": "node", "width": "auto", "add": 0, "edit": { "type": "SelectObject", "validObjectTypes": [1, 2] } }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Den Thermostat-Knoten (die Geräte-Instanz) auswählen -- Soll-/Ist-Temperatur und Heizmodus werden automatisch aus den vorhandenen Datenpunkten gelesen. Die Luftfeuchtigkeit wird automatisch aus der Sensoren-Liste übernommen, falls dort ein Feuchtigkeitssensor konfiguriert ist."
    },
    {
      "type": "List",
      "name": "statusVars",
      "caption": "Status-Variablen (z.B. Bewohner-Status)",
      "rowCount": 3,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Variable (mit Profil-Auswahlliste)", "name": "variable", "width": "auto", "add": 0, "edit": { "type": "SelectVariable" } }
      ],
      "values": []
    },
    {
      "type": "List",
      "name": "lights",
      "caption": "Lichter",
      "rowCount": 5,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Gerät (Schalter/Dimmer-Variable oder Hue-/Govee-Instanz)", "name": "variable", "width": "auto", "add": 0, "edit": { "type": "SelectObject", "validObjectTypes": [1, 2] } }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Bei Hue- oder Govee-Lampen den obersten Geräteknoten auswählen (nicht die Rohvariable) -- Typ (Schalter/Dimmer/Farbe) und Bedienelemente werden automatisch erkannt. Bei einfachen Schaltern/Dimmern wie gewohnt die Variable selbst wählen."
    },
    {
      "type": "List",
      "name": "shutters",
      "caption": "Rollläden",
      "rowCount": 4,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Gerät (Position 0-100 oder TaHoma-Instanz)", "name": "variable", "width": "auto", "add": 0, "edit": { "type": "SelectObject", "validObjectTypes": [1, 2] } }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Bei TaHoma-Rollläden den Geräteknoten auswählen -- bidirektionale (mit Positions-Rückmeldung) bekommen Auf/Zu-Schnellwahl + Regler, unidirektionale (nur Auf/Stop/Zu, kein Rückkanal, z.B. RTS) automatisch nur die passenden Tasten. Bei einer einfachen Prozent-Variable (z.B. Homematic) wie gewohnt die Variable selbst wählen."
    },
    {
      "type": "List",
      "name": "automations",
      "caption": "Automatisierung",
      "rowCount": 3,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Variable (z.B. Systemvariable)", "name": "variable", "width": "auto", "add": 0, "edit": { "type": "SelectVariable" } }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Beliebige Variablen zum Schalten, z.B. eine Systemvariable für eine Lichtautomatisierung. Boolean-Variablen werden als Schalter dargestellt, Variablen mit Profil-Auswahlliste als Buttons."
    },
    {
      "type": "List",
      "name": "smokeDetectors",
      "caption": "Rauchmelder",
      "rowCount": 3,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Gerät (Nest-Protect- oder Homematic-Rauchmelder-Instanz)", "name": "variable", "width": "auto", "add": 0, "edit": { "type": "SelectObject", "validObjectTypes": [1, 2] } }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Den Geräteknoten auswählen. Nest-Protect-Instanzen zeigen Rauch/CO/Hitze-Alarm, Batterie, Stromversorgung, Stummschaltung, letzten Selbsttest und Austauschdatum. Homematic-Rauchmelder zeigen nur den Alarmstatus (Rauch/CO/Batterie liefert dieser Melder-Typ nicht getrennt)."
    },
    {
      "type": "List",
      "name": "vacuums",
      "caption": "Saugroboter",
      "rowCount": 2,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Gerät (Ecovacs-Saugroboter-Instanz)", "name": "variable", "width": "auto", "add": 0, "edit": { "type": "SelectObject", "validObjectTypes": [1] } }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Den Geräteknoten einer Ecovacs-Saugroboter-Instanz auswählen -- Batterie, Status, Saugstufe, letzte Reinigung sowie Start/Pause/Stopp/Basis werden automatisch übernommen."
    },
    {
      "type": "List",
      "name": "sensors",
      "caption": "Sensoren & Kontakte",
      "rowCount": 6,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "180px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Variable", "name": "variable", "width": "200px", "add": 0, "edit": { "type": "SelectVariable" } },
        {
          "caption": "Typ",
          "name": "type",
          "width": "160px",
          "add": "generic",
          "edit": {
            "type": "Select",
            "options": [
              { "caption": "Fenster", "value": "window" },
              { "caption": "Tür", "value": "door" },
              { "caption": "Feuchtigkeit (%)", "value": "humidity" },
              { "caption": "Rauchmelder", "value": "smoke" },
              { "caption": "Sirene", "value": "siren" },
              { "caption": "Sonstiges (Zahl)", "value": "generic" }
            ]
          }
        }
      ],
      "values": []
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "RMD_Refresh($id);"
    }
  ],
  "status": [
    { "code": 102, "icon": "active",   "caption": "Aktiv" },
    { "code": 200, "icon": "error",    "caption": "Fehler – Details im IPS-Log" },
    { "code": 201, "icon": "inactive", "caption": "Nicht konfiguriert – mindestens ein Element hinzufügen" }
  ]
}
